<?xml version="1.0" encoding="utf-8"?>
<DryadArmorConfig>
  <!--
    Dryad Armor Appearance Config
    =============================
    Toggle armor texture overlay for each dryad type.
    true  = show armor
    false = hide armor

    Changes take effect automatically within a few seconds.

    Dryad types:
      Dryad_Basic        - Basic dryad
      Dryad_Woodmaker    - Woodmaker
      Dryad_Berrymaker   - Berrymaker
      Dryad_Medicinemaker - Medicinemaker
      Dryad_Gaumaker     - Gaumaker
      Dryad_Carrier      - Carrier
      Dryad_Clawer       - Clawer
      Dryad_Barkskin     - Barkskin
  -->
  <Dryad_Basic>true</Dryad_Basic>
  <Dryad_Woodmaker>true</Dryad_Woodmaker>
  <Dryad_Berrymaker>true</Dryad_Berrymaker>
  <Dryad_Medicinemaker>true</Dryad_Medicinemaker>
  <Dryad_Gaumaker>true</Dryad_Gaumaker>
  <Dryad_Carrier>true</Dryad_Carrier>
  <Dryad_Clawer>true</Dryad_Clawer>
  <Dryad_Barkskin>true</Dryad_Barkskin>

  <!--
    Dryad Old Body Art  (feature added by this copy)
    ================================================
    true  = use the OLD body art   (clothing display is NOT supported: the armour
                                    overlay for that caste is hidden automatically)
    false = use the modern body art (default)

    Each caste is switched independently.

    NOTE: this file is DOCUMENTATION ONLY and is never read at runtime.
    The real setting lives in Options -> Mod settings -> Humanoid Dryad and is
    written by RimWorld into Config/Mod_*.xml.
  -->
  <OldBody_Dryad_Basic>false</OldBody_Dryad_Basic>
  <OldBody_Dryad_Woodmaker>false</OldBody_Dryad_Woodmaker>
  <OldBody_Dryad_Berrymaker>false</OldBody_Dryad_Berrymaker>
  <OldBody_Dryad_Medicinemaker>false</OldBody_Dryad_Medicinemaker>
  <OldBody_Dryad_Gaumaker>false</OldBody_Dryad_Gaumaker>
  <OldBody_Dryad_Carrier>false</OldBody_Dryad_Carrier>
  <OldBody_Dryad_Clawer>false</OldBody_Dryad_Clawer>
  <OldBody_Dryad_Barkskin>false</OldBody_Dryad_Barkskin>
</DryadArmorConfig>
